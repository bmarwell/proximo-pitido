<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
  <modelVersion>4.1.0</modelVersion>

  <parent />

  <artifactId>proximo-pitido-war</artifactId>

  <packaging>war</packaging>

  <name>Proximo Pitido :: Web Application (SIP)</name>

  <dependencies>
    <!-- JakartaEE: Stuck at JakartaEE 8.0 because of old sip-api. -->
    <dependency>
      <groupId>com.ibm.ws.java</groupId>
      <artifactId>com.ibm.ws.java.sipServlet.1.1</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.microprofile.config</groupId>
      <artifactId>microprofile-config-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.microprofile.health</groupId>
      <artifactId>microprofile-health-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>de.bmarwell.proximo.pitido</groupId>
      <artifactId>proximo-pitido-api</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>de.bmarwell.proximo.pitido</groupId>
      <artifactId>proximo-pitido-spi</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>de.bmarwell.proximo.pitido</groupId>
      <artifactId>proximo-pitido-core</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>de.bmarwell.proximo.pitido</groupId>
      <artifactId>proximo-pitido-codecs-input</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>de.bmarwell.proximo.pitido</groupId>
      <artifactId>proximo-pitido-codecs-sip</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>

    <!-- Language implementations -->
    <dependency>
      <groupId>de.bmarwell.proximo.pitido</groupId>
      <artifactId>proximo-pitido-languages-de-de</artifactId>
      <version>1.0.0-SNAPSHOT</version>
      <scope>runtime</scope>
    </dependency>

    <!-- OGG Opus audio decoding and MIME detection live in proximo-pitido-codecs-input. -->
    <!-- Bridge Tika's SLF4J calls to java.util.logging (JUL), which Liberty captures into messages.log. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.openliberty.tools</groupId>
        <artifactId>liberty-maven-plugin</artifactId>
        <configuration>
          <installAppPackages>project</installAppPackages>

          <serverName>proximo-pitido</serverName>
          <userDirectory>${project.build.directory}/wlp-usr</userDirectory>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration combine.self="override">
          <!-- cleanthat 2.25 crashes with InvocationTargetException on Java record types
               when compiled with Java 25 (cleanthat bug). Provide a full java config here
               that matches the parent but omits cleanthat for this module. -->
          <java>
            <importOrder />
            <removeUnusedImports />
            <palantirJavaFormat>
              <version>${dependency.palantir.version}</version>
            </palantirJavaFormat>
            <licenseHeader>
              <content><![CDATA[
/*
 * Licensed under the EUPL, Version 1.2 or – as soon they will be approved by the European Commission - subsequent
 * versions of the EUPL (the "Licence");
 * You may not use this work except in compliance with the Licence.
 * You may obtain a copy of the Licence at:
 *
 * ${PROJECT_HOME}/LICENSE
 *
 * Unless required by applicable law or agreed to in writing, software distributed under the Licence is
 * distributed on an "AS IS" basis, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
 * See the Licence for the specific language governing permissions and limitations under the Licence.
 */
]]></content>
            </licenseHeader>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
