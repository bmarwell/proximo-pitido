<?xml version="1.0" encoding="UTF-8"?>
<server description="Proximo Pitido SIP Server">

  <featureManager>
    <platform>javaee-8.0</platform>
    <feature>sipServlet-1.1</feature>
    <feature>servlet</feature>
    <feature>cdi</feature>

    <platform>microProfile-4.1</platform>
    <feature>mpConfig</feature>
    <feature>mpHealth</feature>
  </featureManager>

  <!--
    SIP_LOCAL_HOST (server.env): LAN IPv4 the SIP endpoint binds to.
    Must be a real network interface IP (not loopback) so Liberty can establish
    outbound TCP connections to the registrar. Defaults to "*" (auto), but "*"
    resolves to 127.0.1.1 on many Linux systems — breaking outbound TCP.
    SIP_PUBLIC_HOST (server.env): public IP advertised in the Contact header.
    Port 5060 must be forwarded on the router: external 5060 → SIP_LOCAL_HOST:5060.
  -->
  <variable name="sip.bind.host" value="${env.SIP_LOCAL_HOST}" defaultValue="*" />
  <sipEndpoint id="defaultSipEndpoint"
    host="${sip.bind.host}"
    sipUDPPort="5060"
    sipTCPPort="5060"
    sipTLSPort="5061"
  />
  <httpEndpoint id="defaultHttpEndpoint" host="*" httpPort="9080" />

  <!--
    Configure the Default Application Router (DAR) with an explicit method list.
    REGISTER is omitted so outgoing REGISTER requests are forwarded to the network
    instead of being looped back through application composition.
    See war/src/main/liberty/config/dar.properties.
  -->
  <sipApplicationRouter sipDarConfiguration="${server.config.dir}/dar.properties" />

  <cdi enableImplicitBeanArchives="false" />

  <!--
    Default runtime logging profile.
    Liberty base level stays at AUDIT for framework noise control.
    SipCallHandler runs at DEBUG by default to inspect caller identity headers, codec choices, DTMF input, and call lifecycle transitions.
    SipRegistrationListener runs at INFO by default to track REGISTER/auth progress without per-attempt DEBUG noise.

    Optional trace selectors to enable when diagnosing specific problems:
    - de.bmarwell.proximo.pitido.war.media.SdpNegotiator=debug
      Shows parsed SDP offer details, selected RTP endpoint data, and codec matching.
    - de.bmarwell.proximo.pitido.war.media.RtpAudioPlayer=debug
      Shows RTP packetisation/send-path details and is usually too verbose for normal operation.
    - de.bmarwell.proximo.pitido.codecs.input.*=debug
      Shows native decoder and mixer capability probes (opus/soxr) and fallback decisions.
    - de.bmarwell.proximo.pitido.codecs.sip.*=debug
      Shows SIP codec availability probes (for example, G.722 native encoder readiness).
  -->
  <logging
    consoleLogLevel="INFO"
    consoleFormat="TBASIC"
    traceSpecification="*=audit:de.bmarwell.proximo.pitido.war.listener.SipCallHandler=debug:de.bmarwell.proximo.pitido.war.listener.SipRegistrationListener=info"
    hideMessage="CWOWB1009W"
    isoDateFormat="true"
  />
</server>
