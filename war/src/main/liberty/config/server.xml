<?xml version="1.0" encoding="UTF-8"?>
<server description="Proximo Pitido SIP Server">

  <featureManager>
    <platform>javaee-8.0</platform>
    <feature>sipServlet-1.1</feature>
    <feature>servlet</feature>
    <feature>cdi</feature>

    <platform>microProfile-4.1</platform>
    <feature>mpConfig</feature>
    <feature>mpHealth</feature>
    <feature>mpOpenApi</feature>
  </featureManager>

  <sipEndpoint id="defaultSipEndpoint"
    host="*"
    sipAddressPort="5060"/>
  <httpEndpoint id="defaultHttpEndpoint" host="*" httpPort="9080" />

  <cdi enableImplicitBeanArchives="false" />

  <variable name="SIP_PHONE_NUMBER" value="+1234567890"/>
  <variable name="SIP_PROVIDER_URL" value="sip:provider.com"/>
  <variable name="SIP_USERNAME" value="my_user"/>
  <variable name="SIP_PASSWORD" value="my_secret_password"/>

  <variable name="sip.phone.number" value="${env.SIP_PHONE_NUMBER:-}"/>
</server>
