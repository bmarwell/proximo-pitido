<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
  version="4.0">

  <display-name>Proximo Pitido</display-name>

  <!--
    while SipFactory is available as ServletContextAttribute,
    it is only available for Servlets extending SipServlet,
    and not available for WebListeners etc. by default.
    With making it available to InitialContext,
    we can use a CDI extension on top of it.
  -->
  <resource-env-ref>
    <resource-env-ref-name>sip/SipFactory</resource-env-ref-name>
    <resource-env-ref-type>javax.servlet.sip.SipFactory</resource-env-ref-type>
  </resource-env-ref>

</web-app>
