<?xml version="1.0" encoding="UTF-8"?>
<sip-app xmlns="http://www.jcp.org/xml/ns/sipservlet"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.jcp.org/xml/ns/sipservlet http://www.jcp.org/xml/ns/sipservlet/sip-app_1_1.xsd"
  version="1.1">

  <app-name>Proximo Pitido</app-name>
  <display-name>Proximo Pitido</display-name>
  <!--
    Servlet registration and loadOnStartup are handled via the @SipServlet annotation.
    REGISTER routing is controlled via dar.properties (sipApplicationRouter in server.xml):
    REGISTER is omitted from the DAR so outgoing REGISTERs are forwarded to the network
    instead of looping back through application composition (which would produce a local 405).
  -->
</sip-app>
